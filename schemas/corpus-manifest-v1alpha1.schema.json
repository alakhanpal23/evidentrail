{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:evidentrail:schema:corpus-manifest:v1alpha1",
  "title": "Evidentrail corpus manifest v1alpha1",
  "description": "Governance, integrity, split, privacy, and lineage contract for one Evidentrail corpus case. A valid manifest is necessary but not sufficient authorization: policy enforcement must also verify lifecycle state, signatures or receipts, canonical source containment, and current revocation state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "manifest_revision",
    "lifecycle",
    "corpus_id",
    "case_id",
    "family_id",
    "split",
    "split_keys",
    "title",
    "description",
    "source",
    "provenance",
    "format",
    "classification",
    "consent",
    "revocation",
    "redaction",
    "privacy_scan",
    "integrity",
    "retention",
    "annotations",
    "lineage"
  ],
  "properties": {
    "schema_version": {
      "const": "evidentrail.corpus-manifest/v1alpha1"
    },
    "manifest_id": {
      "$ref": "#/$defs/opaque_id"
    },
    "manifest_revision": {
      "type": "integer",
      "minimum": 1
    },
    "lifecycle": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "quarantined",
        "revoked",
        "prohibited"
      ]
    },
    "corpus_id": {
      "$ref": "#/$defs/opaque_id"
    },
    "case_id": {
      "$ref": "#/$defs/opaque_id"
    },
    "family_id": {
      "$ref": "#/$defs/opaque_id",
      "description": "Stable leakage-control identity shared by every incident, generator, trace, or near-duplicate variant that must remain in one split."
    },
    "split": {
      "type": "string",
      "enum": [
        "train",
        "validation",
        "public_test",
        "private_test",
        "conformance",
        "stress",
        "unsplit"
      ]
    },
    "split_keys": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "organization_id",
        "time_bucket",
        "provider_family",
        "fault_family",
        "dedupe_group_id"
      ],
      "properties": {
        "project_id": {
          "$ref": "#/$defs/opaque_id"
        },
        "organization_id": {
          "$ref": "#/$defs/opaque_id"
        },
        "time_bucket": {
          "$ref": "#/$defs/opaque_id"
        },
        "provider_family": {
          "$ref": "#/$defs/opaque_id"
        },
        "fault_family": {
          "$ref": "#/$defs/opaque_id"
        },
        "dedupe_group_id": {
          "$ref": "#/$defs/opaque_id"
        }
      }
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "format": {
      "$ref": "#/$defs/format"
    },
    "classification": {
      "$ref": "#/$defs/classification"
    },
    "consent": {
      "$ref": "#/$defs/consent"
    },
    "revocation": {
      "$ref": "#/$defs/revocation"
    },
    "redaction": {
      "$ref": "#/$defs/redaction"
    },
    "privacy_scan": {
      "$ref": "#/$defs/privacy_scan"
    },
    "integrity": {
      "$ref": "#/$defs/integrity"
    },
    "retention": {
      "$ref": "#/$defs/retention"
    },
    "annotations": {
      "$ref": "#/$defs/annotations"
    },
    "lineage": {
      "$ref": "#/$defs/lineage"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "lifecycle": {
            "const": "active"
          }
        },
        "required": [
          "lifecycle"
        ]
      },
      "then": {
        "properties": {
          "classification": {
            "properties": {
              "review_status": {
                "const": "approved"
              }
            }
          },
          "consent": {
            "properties": {
              "grants": {
                "properties": {
                  "local_processing": {
                    "const": true
                  }
                }
              }
            }
          },
          "revocation": {
            "properties": {
              "status": {
                "const": "active"
              }
            }
          },
          "redaction": {
            "properties": {
              "unresolved_high_confidence_findings": {
                "const": 0
              }
            }
          },
          "privacy_scan": {
            "properties": {
              "unresolved_high_confidence_findings": {
                "const": 0
              }
            }
          },
          "integrity": {
            "properties": {
              "materialization_state": {
                "enum": [
                  "materialized",
                  "verified"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lifecycle": {
            "const": "revoked"
          }
        },
        "required": [
          "lifecycle"
        ]
      },
      "then": {
        "properties": {
          "revocation": {
            "properties": {
              "status": {
                "const": "revoked"
              },
              "stop_new_use_at": {
                "type": "string",
                "format": "date-time"
              },
              "delete_by": {
                "type": "string",
                "format": "date-time"
              },
              "deletion_receipt_sha256": {
                "$ref": "#/$defs/sha256"
              },
              "tombstone_id": {
                "$ref": "#/$defs/opaque_id"
              }
            }
          },
          "consent": {
            "properties": {
              "grants": {
                "$ref": "#/$defs/all_grants_denied"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "classification": {
            "properties": {
              "sensitivity": {
                "const": "prohibited"
              }
            },
            "required": [
              "sensitivity"
            ]
          }
        },
        "required": [
          "classification"
        ]
      },
      "then": {
        "properties": {
          "lifecycle": {
            "const": "prohibited"
          },
          "consent": {
            "properties": {
              "grants": {
                "$ref": "#/$defs/all_grants_denied"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source": {
            "properties": {
              "kind": {
                "const": "synthetic_generator"
              }
            },
            "required": [
              "kind"
            ]
          }
        },
        "required": [
          "source"
        ]
      },
      "then": {
        "properties": {
          "source": {
            "required": [
              "generator"
            ],
            "properties": {
              "locator": {
                "type": "string",
                "pattern": "^generator://"
              },
              "approved_root": {
                "type": "null"
              }
            }
          },
          "provenance": {
            "properties": {
              "authorization_basis": {
                "const": "first_party_synthetic"
              }
            }
          },
          "classification": {
            "properties": {
              "data_class": {
                "const": "C0"
              },
              "sensitivity": {
                "const": "synthetic"
              },
              "content_state": {
                "const": "synthetic"
              },
              "contains_real_person_data": {
                "const": false
              },
              "contains_customer_data": {
                "const": false
              },
              "contains_secrets": {
                "const": false
              }
            }
          },
          "redaction": {
            "properties": {
              "exactness_basis": {
                "const": "synthetic_bytes"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source": {
            "properties": {
              "kind": {
                "enum": [
                  "local_file",
                  "local_glob",
                  "ci_artifact_directory"
                ]
              }
            },
            "required": [
              "kind"
            ]
          }
        },
        "required": [
          "source"
        ]
      },
      "then": {
        "properties": {
          "source": {
            "properties": {
              "approved_root": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "classification": {
            "properties": {
              "data_class": {
                "enum": [
                  "C3",
                  "C4"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source": {
            "properties": {
              "kind": {
                "const": "external_dogfood"
              }
            },
            "required": [
              "kind"
            ]
          }
        },
        "required": [
          "source"
        ]
      },
      "then": {
        "properties": {
          "source": {
            "required": [
              "external_boundary"
            ]
          },
          "classification": {
            "properties": {
              "data_class": {
                "enum": [
                  "C3",
                  "C4"
                ]
              }
            }
          },
          "consent": {
            "properties": {
              "grants": {
                "properties": {
                  "publication": {
                    "const": false
                  },
                  "content_telemetry": {
                    "const": false
                  },
                  "model_training": {
                    "const": false
                  }
                }
              }
            }
          },
          "retention": {
            "properties": {
              "ordinary_repository_allowed": {
                "const": false
              },
              "ordinary_ci_allowed": {
                "const": false
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "consent": {
            "properties": {
              "grants": {
                "properties": {
                  "model_training": {
                    "const": true
                  }
                },
                "required": [
                  "model_training"
                ]
              }
            },
            "required": [
              "grants"
            ]
          }
        },
        "required": [
          "consent"
        ]
      },
      "then": {
        "properties": {
          "classification": {
            "properties": {
              "data_class": {
                "const": "C4"
              }
            }
          },
          "split": {
            "enum": [
              "train",
              "validation",
              "stress",
              "unsplit"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "split": {
            "enum": [
              "public_test",
              "private_test",
              "conformance"
            ]
          }
        },
        "required": [
          "split"
        ]
      },
      "then": {
        "properties": {
          "consent": {
            "properties": {
              "grants": {
                "properties": {
                  "model_training": {
                    "const": false
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "anyOf": [
          {
            "properties": {
              "redaction": {
                "properties": {
                  "unresolved_high_confidence_findings": {
                    "minimum": 1
                  }
                },
                "required": [
                  "unresolved_high_confidence_findings"
                ]
              }
            },
            "required": [
              "redaction"
            ]
          },
          {
            "properties": {
              "privacy_scan": {
                "properties": {
                  "unresolved_high_confidence_findings": {
                    "minimum": 1
                  }
                },
                "required": [
                  "unresolved_high_confidence_findings"
                ]
              }
            },
            "required": [
              "privacy_scan"
            ]
          }
        ]
      },
      "then": {
        "properties": {
          "lifecycle": {
            "enum": [
              "draft",
              "quarantined",
              "prohibited"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "retention": {
            "properties": {
              "ordinary_repository_allowed": {
                "const": true
              }
            },
            "required": [
              "ordinary_repository_allowed"
            ]
          }
        },
        "required": [
          "retention"
        ]
      },
      "then": {
        "properties": {
          "classification": {
            "properties": {
              "data_class": {
                "const": "C0"
              },
              "sensitivity": {
                "enum": [
                  "synthetic",
                  "public"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "annotations": {
            "properties": {
              "state": {
                "const": "verified_incident"
              }
            },
            "required": [
              "state"
            ]
          }
        },
        "required": [
          "annotations"
        ]
      },
      "then": {
        "properties": {
          "classification": {
            "properties": {
              "data_class": {
                "const": "C4"
              }
            }
          },
          "annotations": {
            "properties": {
              "root_cause_sha256": {
                "$ref": "#/$defs/sha256"
              },
              "verified_fix_sha256": {
                "$ref": "#/$defs/sha256"
              },
              "outcome": {
                "enum": [
                  "fixed_verified",
                  "diagnosis_verified"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lineage": {
            "properties": {
              "model_training_export_ids": {
                "minItems": 1
              }
            },
            "required": [
              "model_training_export_ids"
            ]
          }
        },
        "required": [
          "lineage"
        ]
      },
      "then": {
        "properties": {
          "consent": {
            "properties": {
              "grants": {
                "properties": {
                  "model_training": {
                    "const": true
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "opaque_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "nullable_sha256": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullable_datetime": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "opaque_id_array": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/opaque_id"
      }
    },
    "grants": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "local_processing",
        "local_persistence",
        "benchmark_use",
        "human_review",
        "remote_processing",
        "external_model_judging",
        "publication",
        "content_telemetry",
        "model_training"
      ],
      "properties": {
        "local_processing": {
          "type": "boolean"
        },
        "local_persistence": {
          "type": "boolean"
        },
        "benchmark_use": {
          "type": "boolean"
        },
        "human_review": {
          "type": "boolean"
        },
        "remote_processing": {
          "type": "boolean"
        },
        "external_model_judging": {
          "type": "boolean"
        },
        "publication": {
          "type": "boolean"
        },
        "content_telemetry": {
          "type": "boolean"
        },
        "model_training": {
          "type": "boolean"
        }
      }
    },
    "all_grants_denied": {
      "allOf": [
        {
          "$ref": "#/$defs/grants"
        },
        {
          "properties": {
            "local_processing": {
              "const": false
            },
            "local_persistence": {
              "const": false
            },
            "benchmark_use": {
              "const": false
            },
            "human_review": {
              "const": false
            },
            "remote_processing": {
              "const": false
            },
            "external_model_judging": {
              "const": false
            },
            "publication": {
              "const": false
            },
            "content_telemetry": {
              "const": false
            },
            "model_training": {
              "const": false
            }
          }
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "locator",
        "approved_root",
        "allow_patterns",
        "deny_patterns",
        "discovery",
        "acquisition",
        "source_spec_sha256"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "synthetic_generator",
            "version_controlled_fixture",
            "public_dataset",
            "local_file",
            "local_glob",
            "stdin_capture",
            "child_process_capture",
            "docker_capture",
            "kubernetes_capture",
            "journald_capture",
            "ci_artifact_directory",
            "provider_export",
            "external_dogfood"
          ]
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "approved_root": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2048
        },
        "allow_patterns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "deny_patterns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "discovery": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "recursive",
            "max_depth",
            "canonicalize_and_enforce_containment",
            "reject_special_files"
          ],
          "properties": {
            "mode": {
              "const": "explicit_only"
            },
            "recursive": {
              "type": "boolean"
            },
            "max_depth": {
              "type": "integer",
              "minimum": 0,
              "maximum": 64
            },
            "canonicalize_and_enforce_containment": {
              "const": true
            },
            "reject_special_files": {
              "const": true
            }
          }
        },
        "acquisition": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bounded",
            "file_limit",
            "record_limit",
            "byte_limit",
            "wall_time_ms",
            "time_window"
          ],
          "properties": {
            "bounded": {
              "const": true
            },
            "file_limit": {
              "type": "integer",
              "minimum": 1
            },
            "record_limit": {
              "type": "integer",
              "minimum": 1
            },
            "byte_limit": {
              "type": "integer",
              "minimum": 1
            },
            "wall_time_ms": {
              "type": "integer",
              "minimum": 1
            },
            "time_window": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "start",
                "end"
              ],
              "properties": {
                "start": {
                  "$ref": "#/$defs/nullable_datetime"
                },
                "end": {
                  "$ref": "#/$defs/nullable_datetime"
                }
              }
            }
          }
        },
        "source_spec_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "repository": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "identity",
            "revision",
            "tracked_members_only"
          ],
          "properties": {
            "identity": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "revision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "tracked_members_only": {
              "type": "boolean"
            }
          }
        },
        "generator": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version",
            "seed",
            "spec_sha256"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "seed": {
              "type": "integer",
              "minimum": 0
            },
            "spec_sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "external_boundary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "product_id",
            "relationship",
            "copy_authorized"
          ],
          "properties": {
            "product_id": {
              "$ref": "#/$defs/opaque_id"
            },
            "relationship": {
              "const": "opt_in_external_dogfood"
            },
            "copy_authorized": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_id",
        "steward_id",
        "authorization_basis",
        "authorization_reference",
        "manifest_created_at",
        "source_created_at",
        "source_version",
        "license"
      ],
      "properties": {
        "owner_id": {
          "$ref": "#/$defs/opaque_id"
        },
        "steward_id": {
          "$ref": "#/$defs/opaque_id"
        },
        "authorization_basis": {
          "type": "string",
          "enum": [
            "first_party_synthetic",
            "public_license",
            "first_party_owned",
            "explicit_contributor_consent",
            "customer_agreement"
          ]
        },
        "authorization_reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "manifest_created_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_created_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "license": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "identifier",
            "reference",
            "notice_sha256"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "synthetic_policy",
                "spdx",
                "proprietary",
                "data_use_agreement"
              ]
            },
            "identifier": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "reference": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "notice_sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      }
    },
    "format": {
      "type": "object",
